{
    "name": "path-bool",
    "version": "1.0.3",
    "license": "MIT",
    "author": {
        "name": "Adam Platkevič",
        "email": "rflashster@gmail.com"
    },
    "description": "A low-level library for performing boolean operations on SVG paths.",
    "keywords": [
        "vector",
        "path",
        "boolean",
        "bool",
        "svg"
    ],
    "type": "module",
    "main": "./dist/path-bool.js",
    "types": "./dist/types/index.d.ts",
    "files": [
        "dist/path-bool.js",
        "dist/path-bool.js.map",
        "dist/types/**/*"
    ],
    "homepage": "https://r-flash.github.io/PathBool.js/",
    "repository": {
        "url": "git+https://github.com/r-flash/PathBool.js.git",
        "type": "git"
    },
    "devDependencies": {
        "@gitlab-org/jsfuzz": "^1.2.4",
        "@jest/globals": "^30.5.1",
        "@resvg/resvg-js": "^2.6.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-strip": "^3.0.4",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.3.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "cheerio": "^1.2.0",
        "glob": "^13.0.6",
        "globals": "^17.12.0",
        "jest": "^30.5.1",
        "prettier": "3.9.6",
        "rollup": "^4.63.1",
        "ts-jest": "^29.4.12",
        "tslib": "^2.8.1"
    },
    "scripts": {
        "build": "NODE_ENV=production rollup -c",
        "build-dev": "NODE_ENV=development rollup -c",
        "build-fuzz": "rollup -c fuzzing/rollup.config.js",
        "watch": "NODE_ENV=development rollup -c -w",
        "test": "jest",
        "bench": "node ./bench/path-boolean-bench.mjs",
        "gen-corpus": "node ./scripts/generate-corpus.mjs",
        "pretty": "prettier --write ./src",
        "fuzz": "npm run build-fuzz && jsfuzz --only-ascii=true fuzzing/target.cjs fuzzing/corpus"
    },
    "dependencies": {
        "gl-matrix": "^3.4.4"
    }
}
